PORT=5002
# 仅在 SQLite 中还没有 admin 账号时使用；留空则生成随机初始密码并在启动日志中显示。
# 账号创建后可移除此项；后台改密不会写回 .env。
ADMIN_PASSWORD=

# 后台 JWT 签名密钥：务必设置。缺失时服务端会在启动时随机生成，
# 后果是每次重启都会让所有登录态失效（管理员需重新登录）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_random_jwt_secret_here

# 【临时应急】上游 HTTPS 证书过期 / 不受信时设为 1，关闭出站证书校验以顶过上游修复期。
# 正常务必保持注释 / 留空 —— 关闭校验等于对所有上游请求开了中间人后门，上游恢复后请移除。
# UPSTREAM_TLS_INSECURE=1

# 反向代理层数。线上链路是「用户 → EdgeOne(CDN) → nginx → Node」，所以填 2（也是默认值）；
# 只有 nginx 一层时填 1（或 loopback），完全直连没有代理时填 false。
# 它决定 req.ip 取 X-Forwarded-For 的哪一段，进而决定各处按 IP 的限流是否可信。
# 注意：取访客 IP 用的是下面的 TRUSTED_FRONT_PROXY_IPS + CDN 头，不是这里。
TRUST_PROXY=2

# 自己的前置反代（把本站整个代理出去的那台机器）的 IP，逗号分隔，例如：
# 链路「访客 → 前置反代 → EdgeOne → nginx → Node」下，EdgeOne 看到的连接方是代理机，
# CDN 头只会给出代理机 IP；只有 CDN 头命中这个名单时，服务端才会改用 X-Forwarded-For
# 最左段里的真实访客 IP。前提是那台代理机配置了转发访客 IP（见部署说明）。
TRUSTED_FRONT_PROXY_IPS=

# 上传护栏（留空即用代码里的默认值）
UPLOAD_MAX_BYTES=268435456        # /api/upload 单文件上限，默认 256MB

# 限流阈值（0 表示关闭对应限流）
LOGIN_MAX_FAILURES=5              # 登录失败多少次后锁定
LOGIN_LOCK_MS=900000              # 锁定时长，默认 15 分钟

# 脚本护栏：按 UA 识别脚本，超限返回 429 警告页（见 server/lib/script-guard.cjs）
SCRIPT_GUARD_ENABLED=1            # 设 0 整体关闭
SCRIPT_GUARD_FREE_HITS=20         # 宽限次数，设 0 = 一发现就拦
SCRIPT_GUARD_WINDOW_MS=600000     # 统计窗口，默认 10 分钟
SCRIPT_GUARD_BLOCK_MS=900000      # 首次封禁时长，屡犯按 4 倍递增，上限 24 小时
SCRIPT_GUARD_CONTACT=             # 警告页申诉入口的默认值，留空用「关于」页
# 放行名单（哪些客户端不计次、不封禁）不在 .env 里配，见后台「脚本护栏 → 放行名单」，存 system_settings。

# —— 出站 HTTP 配置（见 server/lib/upstream-http.cjs）——
# 连接池（keep-alive）：同主机 socket 上限 / 空闲可回收数 / 空闲多久关闭
UPSTREAM_MAX_SOCKETS=32
UPSTREAM_MAX_FREE_SOCKETS=8
UPSTREAM_KEEPALIVE_MS=15000

# 建连 + 等响应头超时；AXIOS_DEFAULT_TIMEOUT_MS 是没写 timeout 时的兜底
UPSTREAM_TIMEOUT_MS=15000
AXIOS_DEFAULT_TIMEOUT_MS=15000
# 非流式响应体积上限
AXIOS_DEFAULT_MAX_CONTENT_LENGTH=33554432
