{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "closestore",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["enable_nodejs_http_server_modules"],
  // 固定在香港（AWS ap-east-1）附近运行，离华为上游更近
  "placement": { "region": "aws:ap-east-1" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "vars": {
    "SITE_ORIGIN": "https://ag.ljlvink.top"
  },
  "routes": [{ "pattern": "ag.ljlvink.top", "custom_domain": true }],
  "triggers": { "crons": ["0 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "REALTIME", "class_name": "Realtime" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Realtime"] }],
  "observability": { "enabled": true }
}
